{
  "name": "cintac-comex-backend",
  "version": "1.1.0",
  "description": "API REST del cotizador de importaciones CINTAC con PostgreSQL",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "seed": "node scripts/seed.js",
    "start": "node src/index.js",
